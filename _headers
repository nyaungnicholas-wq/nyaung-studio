# Cloudflare Pages / Netlify headers
#
# NOTE (SEO / preview-domain indexing): the temporary Vercel preview host
# (nyaung-studio.vercel.app) is de-indexed via a host-scoped X-Robots-Tag rule
# in vercel.json (source "/(.*)" with has host == nyaung-studio.vercel.app).
# This _headers file cannot scope by hostname, so DO NOT add a noindex here —
# it would also block the canonical domain nicholasnyaung.com. If this site is
# ever served for real from Cloudflare/Netlify on a preview subdomain, noindex
# that preview domain in the host's dashboard instead.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self' 'unsafe-inline' https://unpkg.com https://cdnjs.cloudflare.com https://plausible.io; style-src 'self' 'unsafe-inline' https://api.fontshare.com https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com https://api.fontshare.com; img-src 'self' data: https:; connect-src 'self' https://plausible.io https://formspree.io; manifest-src 'self'; frame-ancestors 'self'

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/assets/*
  Cache-Control: public, max-age=86400
